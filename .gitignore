# --- Dependencies ---
node_modules/
**/node_modules/

# --- Build & dev cache (never commit) ---
dist/
dist-ssr/
**/.vite/
.vite/
client/dist/
client/dist.zip
*.compress-tmp

# --- Secrets (never commit) ---
.env
.env.local
.env.*.local

# --- Logs & test output ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
coverage/

# --- OS junk ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editor (keep shared VS Code recommendations if you add them) ---
.idea/
.vscode/*
!.vscode/extensions.json

# --- Generated by client/scripts/extract-catalog-images.mjs (source: public/catalog/*.pdf) ---
client/public/catalog/snacks/
client/public/catalog/powder/
client/public/catalog/NaturePrue-Fresh-LLP-Snacks/
client/public/catalog/Naturepure-fresh-Powder/

# --- Internal project docs (not for the repo) ---
docs/

# --- Archived public assets (moved by scripts/prune-public-images.mjs) ---
client/unused-public-assets/

# --- Unreferenced duplicates under public/ (not used by the live storefront) ---
client/public/products/product view/ad-posters-chunks/
client/public/products/product view/**/catalog format/
client/public/products/product view/apple/
client/public/products/product view/coconut/
client/public/products/product view/ice cream/
